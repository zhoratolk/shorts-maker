#!/usr/bin/env bash
# Runs a stage of the pipeline on the server's GPU, holding the card while it runs.
#
#   shorts ingest  /media/recordings/2026-08-25.mkv
#   shorts render  --plan work/<stem>/PLAN.json ...
#   shorts shell                                  # a prompt inside the image
#
# The card is borrowed rather than taken. While this runs, a claim file tells the
# business queue on this machine to send new work to the other card; when this exits -
# normally, by Ctrl-C, or by being killed - the claim goes away and the card is back in
# the pool within seconds.
#
# The claim is written here in shell rather than by calling the business project's
# helper, deliberately: what the two projects share is a file format, not a program. A
# claim is a file with a name and a fresh timestamp, and anything that can touch a file
# can hold a card.
set -euo pipefail

IMAGE=${SHORTS_IMAGE:-shorts-maker:latest}
GPU=${SHORTS_GPU:-1}
CLAIMS=${GPU_CLAIMS_DIR:-/srv/work/gpu-claims}
ROOT=${SHORTS_ROOT:-/srv/shorts-maker}
MEDIA=${SHORTS_MEDIA:-/srv/media}

if [ $# -eq 0 ]; then
    echo "usage: shorts <fetch|ingest|render|shell|python3|...> [args...]" >&2
    exit 2
fi

# Recordings are read-only for every stage that reads them, which is all of them but one:
# fetch exists to put a recording there. Widened for that subcommand alone, so a bug in a
# render filter still cannot touch the only copy of a stream.
recordings_mode=":ro"
[ "${1}" = "fetch" ] && recordings_mode=""

# Downloading is network and disk, not GPU. Claiming a card for the hour a three-hour VOD
# takes to arrive would hold it out of the paying queue for nothing - the exact waste the
# claim exists to prevent.
holds_gpu=1
[ "${1}" = "fetch" ] && holds_gpu=0

# The model cache is a mount rather than something baked into the image: the container is
# --rm, and without it every single run would re-download several gigabytes of whisper
# weights before it could say a word.
mkdir -p "$CLAIMS" "$ROOT/work" "$ROOT/cache" "$MEDIA/clips" "$MEDIA/recordings"

claim="$CLAIMS/gpu$GPU"
heartbeat=""
if [ "$holds_gpu" = "1" ]; then
    echo "shorts-maker pid=$$" > "$claim"

    # The reader treats a claim older than two minutes as abandoned, so a beat every
    # thirty seconds can miss three in a row - to a loaded machine or a stalled disk -
    # before the card is handed back while this is still using it.
    ( while sleep 30; do touch "$claim" 2>/dev/null || exit 0; done ) &
    heartbeat=$!
fi

# Runs on every exit path there is, which is the whole point: a claim left behind keeps a
# card out of the queue until it expires, and the queue is the side with paying work.
cleanup() {
    [ -n "$heartbeat" ] && kill "$heartbeat" 2>/dev/null
    [ "$holds_gpu" = "1" ] && rm -f "$claim"
    return 0
}
trap cleanup EXIT INT TERM

# -t only when there is a terminal to attach to: the same script is meant to be callable
# from a watcher or a timer, and docker refuses a TTY-enabled container when stdin is not
# one ("cannot attach stdin to a TTY-enabled container because stdin is not a terminal").
#
# -i is always passed, which -t used to be bundled with. Without it docker gives the
# container no stdin at all, so `shorts python3 - <script` over ssh or from a timer read
# EOF, did nothing, and exited 0 - a script that silently does not run is worse than one
# that fails. -i on its own is fine with a closed stdin; only -t needs the terminal.
interactive=(-i)
[ -t 0 ] && interactive=(-it)

env_file=()
[ -f "$ROOT/.env" ] && env_file=(--env-file "$ROOT/.env")

# Run as whoever called this rather than as root inside the container. Transcripts and
# clips land on a share the desktop reaches over the network, and root-owned files there
# are files you can look at but not tidy up.
#
# A container user with no home directory needs one it can write to, or every library that
# caches something falls over on the first write. /cache is the mounted one, so HOME and
# the cache both point at a directory this user owns.
as_you=(--user "$(id -u):$(id -g)" -e HOME=/cache/home -e XDG_CACHE_HOME=/cache)

case "${1}" in
    shell) shift; set -- bash "$@" ;;
    ingest) shift; set -- python3 scripts/ingest.py "$@" ;;
    render) shift; set -- python3 scripts/render_batch.py "$@" ;;
    fetch) shift; set -- python3 scripts/fetch.py "$@" ;;
esac

# No card for a download. Asking for one anyway would fail outright on a machine whose
# only GPU is busy, and succeed pointlessly on one where it is free.
gpus=(--gpus "device=$GPU")
[ "$holds_gpu" = "1" ] || gpus=()

# data/ and assets/ are mounted for a different reason than the code: .dockerignore keeps
# them out of the build context deliberately - they are content, not dependencies - so the
# image has no copy of them at all to mount over. Without these two lines the profanity
# wordlist, the censor sound and the twitch glyph do not exist inside the container, and
# every one of those is fail-open: the run exits 0 and writes clips with no masking, no
# social capsule and no outro card, saying so only in a warning line. Six clips were
# rendered exactly that way on 2026-08-27 before the log was read.
#
# The code is mounted over the copy baked into the image on purpose: the image carries the
# dependencies, this checkout carries the code. Without it every one-line fix needs a
# rebuild - and worse, an edit made here runs as the old version with no sign anything is
# stale, which is exactly how a script fixed once failed again on the next pass.
# Read-only, because nothing in a run has any business editing the source.
#
# Not `exec`. Replacing this shell with docker would take the EXIT trap above with it, so
# the claim file would never be removed and the heartbeat would outlive the run - the card
# would stay out of the queue until the claim expired, every single time.
status=0
docker run --rm \
    "${interactive[@]}" \
    "${gpus[@]}" \
    "${env_file[@]}" \
    "${as_you[@]}" \
    -v "$ROOT/cache:/cache" \
    -v "$ROOT/config.server.yaml:/app/config.yaml:ro" \
    -v "$ROOT/scripts:/app/scripts:ro" \
    -v "$ROOT/deploy:/app/deploy:ro" \
    -v "$ROOT/data:/app/data:ro" \
    -v "$ROOT/assets:/app/assets:ro" \
    -v "$ROOT/work:/app/work" \
    -v "$MEDIA/recordings:/media/recordings$recordings_mode" \
    -v "$MEDIA/clips:/media/clips" \
    "$IMAGE" "$@" || status=$?
exit "$status"
